# npm v12 install-time defaults, stated explicitly so every npm version in CI
# and on contributors' machines behaves the same.
#
# Only registry tarballs: no git or remote-URL dependencies, direct or
# transitive.
allow-git=none
allow-remote=none
# Install scripts run only for packages listed as `true` in the `allowScripts`
# block of package.json. An unreviewed package with scripts fails the install
# instead of running with a warning.
strict-allow-scripts=true
