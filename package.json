{
	"name": "pi-jfrog-boost",
	"version": "0.2.3",
	"description": "JFrog Boost integration for the pi coding agent — compacts noisy tool output to save tokens and context. Community project, not affiliated with JFrog.",
	"type": "module",
	"license": "MIT",
	"author": "DarkDiamonD (https://github.com/darkdiamond)",
	"keywords": [
		"pi-package",
		"pi",
		"jfrog",
		"boost",
		"token-optimization",
		"agent",
		"hooks"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/darkdiamond/pi-jfrog-boost.git"
	},
	"homepage": "https://github.com/darkdiamond/pi-jfrog-boost#readme",
	"bugs": "https://github.com/darkdiamond/pi-jfrog-boost/issues",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"src",
		"skills",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"format": "biome check --write .",
		"lint": "biome ci .",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/*.test.ts\"",
		"check": "npm run lint && npm run typecheck && npm test",
		"prepublishOnly": "npm run check"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		],
		"image": "https://raw.githubusercontent.com/darkdiamond/pi-jfrog-boost/main/.github/assets/preview.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@earendil-works/pi-coding-agent": "^0.86.1",
		"@types/node": "^26.6.1",
		"typescript": "^7.0.2"
	},
	"funding": "https://github.com/sponsors/darkdiamond",
	"allowScripts": {
		"@google/genai": false,
		"esbuild": false,
		"protobufjs": false
	}
}
